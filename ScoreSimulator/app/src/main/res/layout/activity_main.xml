<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="16dp">

            <!-- Score card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="18dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="[ SCORE SIMULATOR ]"
                    android:textColor="@color/status_warn"
                    android:textSize="20sp"
                    android:fontFamily="monospace"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:letterSpacing="0.1"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="adjust detection states — score updates live"
                    android:textColor="@color/green_dim"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:layout_marginTop="4dp"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/green_line"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="14dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="SECURITY SCORE"
                        android:textColor="@color/green_dim"
                        android:textSize="11sp"
                        android:fontFamily="monospace"/>

                    <TextView
                        android:id="@+id/score_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="100/100"
                        android:textColor="@color/status_ok"
                        android:textSize="30sp"
                        android:fontFamily="monospace"
                        android:textStyle="bold"/>
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/score_bar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="8dp"
                    android:max="100"
                    android:progress="100"
                    android:progressTint="@color/status_ok"
                    android:progressBackgroundTint="@color/surface_variant"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/green_line"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="10dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="DEDUCTIONS"
                    android:textColor="@color/green_dim"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:id="@+id/breakdown_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/text_dim"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="3dp"/>

            </LinearLayout>

            <!-- Root Access -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="ROOT ACCESS"
                        android:textColor="@color/text_bright"
                        android:textSize="12sp"
                        android:fontFamily="monospace"
                        android:textStyle="bold"
                        android:letterSpacing="0.1"/>

                    <TextView
                        android:id="@+id/root_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="±0"
                        android:textColor="@color/status_ok"
                        android:textSize="11sp"
                        android:fontFamily="monospace"
                        android:textStyle="bold"/>
                </LinearLayout>

                <Spinner
                    android:id="@+id/spin_root"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/green_dim"
                    android:popupBackground="@color/surface_card"/>
            </LinearLayout>

            <!-- Bootloader -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="BOOTLOADER"
                        android:textColor="@color/text_bright"
                        android:textSize="12sp"
                        android:fontFamily="monospace"
                        android:textStyle="bold"
                        android:letterSpacing="0.1"/>

                    <TextView
                        android:id="@+id/bl_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="±0"
                        android:textColor="@color/status_ok"
                        android:textSize="11sp"
                        android:fontFamily="monospace"
                        android:textStyle="bold"/>
                </LinearLayout>

                <Spinner
                    android:id="@+id/spin_bootloader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/green_dim"
                    android:popupBackground="@color/surface_card"/>
            </LinearLayout>

            <!-- Verified Boot State -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="VERIFIED BOOT STATE"
                        android:textColor="@color/text_bright"
                        android:textSize="12sp"
                        android:fontFamily="monospace"
                        android:textStyle="bold"
                        android:letterSpacing="0.1"/>

                    <TextView
                        android:id="@+id/vb_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="±0"
                        android:textColor="@color/status_ok"
                        android:textSize="11sp"
                        android:fontFamily="monospace"
                        android:textStyle="bold"/>
                </LinearLayout>

                <Spinner
                    android:id="@+id/spin_verified_boot"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/green_dim"
                    android:popupBackground="@color/surface_card"/>
            </LinearLayout>

            <!-- Shizuku -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="SHIZUKU ACCESS"
                        android:textColor="@color/text_bright"
                        android:textSize="12sp"
                        android:fontFamily="monospace"
                        android:textStyle="bold"
                        android:letterSpacing="0.1"/>

                    <TextView
                        android:id="@+id/sh_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="±0"
                        android:textColor="@color/status_ok"
                        android:textSize="11sp"
                        android:fontFamily="monospace"
                        android:textStyle="bold"/>
                </LinearLayout>

                <Spinner
                    android:id="@+id/spin_shizuku"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/green_dim"
                    android:popupBackground="@color/surface_card"/>
            </LinearLayout>

            <!-- Boolean flags -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="FLAGS"
                    android:textColor="@color/text_bright"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="dm-verity"
                            android:textColor="@color/text_dim"
                            android:textSize="11sp"
                            android:fontFamily="monospace"/>

                        <TextView
                            android:id="@+id/verity_hint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="enabled  ±0"
                            android:textColor="@color/green_dim"
                            android:textSize="10sp"
                            android:fontFamily="monospace"/>
                    </LinearLayout>

                    <Switch
                        android:id="@+id/sw_dm_verity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:thumbTint="@color/green_bright"
                        android:trackTint="@color/green_dim"/>
                </LinearLayout>

            </LinearLayout>

            <!-- Reset button -->
            <Button
                android:id="@+id/btn_reset"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="[ RESET TO DEFAULTS ]"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:textSize="13sp"
                android:textColor="@color/bg"
                android:letterSpacing="0.1"
                android:background="@drawable/btn_reset"
                android:textAllCaps="false"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</FrameLayout>
